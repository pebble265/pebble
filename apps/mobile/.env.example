# Backend address the app talks to (ngrok URL, or your Mac's Wi-Fi IP for local testing)
EXPO_PUBLIC_API_URL=https://colonist-alkalize-duo.ngrok-free.dev

# "Sign-In with google": the iOS OAuth client id from Google Cloud Console
# (APIs & Services > Credentials > Create OAuth client ID > iOS, bundle id com.thanakron.pebble).
# The backend needs the same id in GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Music card on the "pebble" tab: a Spotify app from https://developer.spotify.com/dashboard
# (Create app > Web API, Redirect URI: pebble://spotify). Paste its Client ID here.
# Add your Spotify account under the app's "User Management" while it is in development mode.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
