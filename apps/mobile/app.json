{
  "expo": {
    "name": "Pebble",
    "slug": "pebble",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pebble",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.thanakron.pebble"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thanakron.pebble"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pebble ใช้รูปภาพเพื่อตั้งเป็นรูปโปรไฟล์ของคุณ",
          "cameraPermission": "Pebble ใช้กล้องเพื่อถ่ายรูปโปรไฟล์ของคุณ",
          "microphonePermission": false
        }
      ],
      "./plugins/with-swift5-expo-jsi",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "bluetoothAlwaysPermission": "Pebble ใช้ Bluetooth เพื่อค้นหาและเชื่อมต่อกับหุ่น pebble(a) ของคุณ"
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Pebble อ่านจำนวนก้าวและอัตราการเต้นของหัวใจจาก Apple Health เพื่อแสดงในสรุปวันนี้",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/without-apple-signin",
      [
        "react-native-alarm-scheduler",
        {
          "alarmKitUsageDescription": "Pebble ใช้นาฬิกาปลุกเพื่อเตือนเวลากินยา ให้ดังแม้เครื่องปิดเสียงหรือล็อกหน้าจออยู่"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
