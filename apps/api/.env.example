# setup.sh สร้างไฟล์ .env จากไฟล์นี้ให้อัตโนมัติ (สุ่มรหัสให้ครบ) · ห้ามเอา .env ขึ้น git
DATABASE_URL="postgresql://pebble_admin:<POSTGRES_PASSWORD>@localhost:5433/pebble"
JWT_ACCESS_SECRET=
# 32 ไบต์ base64:  openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Google Sign-In (ไม่ใส่ก็ได้ ล็อกอินด้วยอีเมล/รหัสผ่านแทน)
GOOGLE_CLIENT_IDS=

# อีเมลลืมรหัสผ่าน · เว้น SMTP_HOST ว่าง = โค้ดจะพิมพ์ใน log ของ backend แทน
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# แชตกับ Pebbi (Claude) · ไม่ใส่ = แชตใช้ไม่ได้ แต่ส่วนอื่นใช้ได้ปกติ
ANTHROPIC_API_KEY=

# อีเมลที่ดูหน้า "Log ผู้ใช้" ในเว็บ admin ได้
ADMIN_EMAILS=
