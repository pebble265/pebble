generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alert_deliveries {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alert_id          String           @db.Uuid
  caretaker_link_id String?          @db.Uuid
  channel           String           @db.VarChar(20)
  sent_at           DateTime         @default(now()) @db.Timestamptz(6)
  acknowledged_at   DateTime?        @db.Timestamptz(6)
  alerts            alerts           @relation(fields: [alert_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  caretaker_links   caretaker_links? @relation(fields: [caretaker_link_id], references: [id], onUpdate: NoAction)

  @@index([alert_id], map: "idx_alert_deliveries_alert")
}

model alerts {
  id                      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                 String             @db.Uuid
  device_id               String?            @db.Uuid
  type                    alert_type
  severity                alert_severity
  related_dose_id         String?            @db.Uuid
  related_conversation_id String?            @db.Uuid
  created_at              DateTime           @default(now()) @db.Timestamptz(6)
  resolved_at             DateTime?          @db.Timestamptz(6)
  alert_deliveries        alert_deliveries[]
  devices                 devices?           @relation(fields: [device_id], references: [id], onUpdate: NoAction)
  conversations           conversations?     @relation(fields: [related_conversation_id], references: [id], onUpdate: NoAction)
  dose_events             dose_events?       @relation(fields: [related_dose_id], references: [id], onUpdate: NoAction)
  users                   users              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_logs {
  id              BigInt   @id @default(autoincrement())
  actor_user_id   String?  @db.Uuid
  actor_device_id String?  @db.Uuid
  action          String   @db.VarChar(50)
  target_user_id  String?  @db.Uuid
  target_type     String?  @db.VarChar(50)
  target_id       String?  @db.Uuid
  ip_address      String?  @db.Inet
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  detail          String?
  success         Boolean  @default(true)
  status_code     Int?     @db.SmallInt
  route           String?  @db.VarChar(120)
  client          String?  @db.VarChar(20)
  duration_ms     Int?
  devices         devices? @relation(fields: [actor_device_id], references: [id], onUpdate: NoAction)
  users           users?   @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction)

  @@index([target_user_id, created_at(sort: Desc)], map: "idx_audit_target")
  @@index([created_at(sort: Desc)], map: "idx_audit_created")
  @@index([actor_user_id, created_at(sort: Desc)], map: "idx_audit_actor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model caretaker_links {
  id                                             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                        String                 @db.Uuid
  caretaker_user_id                              String?                @db.Uuid
  invite_email                                   String?                @db.Citext
  invite_token_hash                              String?                @unique
  invite_expires_at                              DateTime?              @db.Timestamptz(6)
  relationship_label                             String?                @db.VarChar(50)
  status                                         link_status            @default(pending)
  created_at                                     DateTime               @default(now()) @db.Timestamptz(6)
  accepted_at                                    DateTime?              @db.Timestamptz(6)
  revoked_at                                     DateTime?              @db.Timestamptz(6)
  alert_deliveries                               alert_deliveries[]
  users_caretaker_links_caretaker_user_idTousers users?                 @relation("caretaker_links_caretaker_user_idTousers", fields: [caretaker_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_caretaker_links_user_idTousers           users                  @relation("caretaker_links_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  caretaker_permissions                          caretaker_permissions?

  @@index([caretaker_user_id], map: "idx_caretaker_links_caretaker")
  @@index([user_id], map: "idx_caretaker_links_user")
}

model caretaker_permissions {
  link_id                     String          @id @db.Uuid
  alert_on_crisis             Boolean         @default(true)
  alert_on_missed_dose        Boolean         @default(false)
  alert_on_device_offline     Boolean         @default(false)
  view_adherence              Boolean         @default(false)
  view_mood_trend             Boolean         @default(false)
  view_conversation_summaries Boolean         @default(false)
  updated_at                  DateTime        @default(now()) @db.Timestamptz(6)
  caretaker_links             caretaker_links @relation(fields: [link_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model companion_memories {
  id                     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String         @db.Uuid
  content_enc            Bytes
  source_conversation_id String?        @db.Uuid
  created_at             DateTime       @default(now()) @db.Timestamptz(6)
  conversations          conversations? @relation(fields: [source_conversation_id], references: [id], onUpdate: NoAction)
  users                  users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_companion_memories_user")
}

model consents {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  consent_type   String    @db.VarChar(50)
  policy_version String    @db.VarChar(20)
  granted_at     DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, consent_type], map: "idx_consents_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model conversation_summaries {
  conversation_id String        @id @db.Uuid
  summary_enc     Bytes
  mood_score      Int?          @db.SmallInt
  risk_flagged    Boolean       @default(false)
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model conversations {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String                  @db.Uuid
  device_id              String?                 @db.Uuid
  started_at             DateTime                @default(now()) @db.Timestamptz(6)
  ended_at               DateTime?               @db.Timestamptz(6)
  turn_count             Int                     @default(0)
  deleted_at             DateTime?               @db.Timestamptz(6)
  alerts                 alerts[]
  chat_messages          chat_messages[]
  companion_memories     companion_memories[]
  conversation_summaries conversation_summaries?
  devices                devices?                @relation(fields: [device_id], references: [id], onUpdate: NoAction)
  users                  users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, started_at(sort: Desc)], map: "idx_conversations_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model devices {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serial_number      String          @unique @db.VarChar(50)
  owner_user_id      String?         @db.Uuid
  device_secret_hash String
  pairing_code_hash  String?
  pairing_expires_at DateTime?       @db.Timestamptz(6)
  status             device_status   @default(unpaired)
  battery_level      Int?            @db.SmallInt
  firmware_version   String?         @db.VarChar(20)
  pill_slots_total   Int             @default(0) @db.SmallInt
  last_seen_at       DateTime?       @db.Timestamptz(6)
  paired_at          DateTime?       @db.Timestamptz(6)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  alerts             alerts[]
  audit_logs         audit_logs[]
  conversations      conversations[]
  users              users?          @relation(fields: [owner_user_id], references: [id], onUpdate: NoAction)

  @@index([owner_user_id], map: "idx_devices_owner")
}

model dose_events {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id          String               @db.Uuid
  user_id              String               @db.Uuid
  scheduled_at         DateTime             @db.Timestamptz(6)
  status               dose_status          @default(pending)
  dispensed_at         DateTime?            @db.Timestamptz(6)
  confirmed_at         DateTime?            @db.Timestamptz(6)
  confirmed_via        dose_confirm_via?
  note                 String?              @db.VarChar(200)
  alerts               alerts[]
  medication_schedules medication_schedules @relation(fields: [schedule_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([schedule_id, scheduled_at])
  @@index([user_id, scheduled_at(sort: Desc)], map: "idx_dose_events_user_time")
}

model emergency_contacts {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String @db.Uuid
  label      String @db.VarChar(100)
  phone      String @db.VarChar(30)
  sort_order Int    @default(0) @db.SmallInt
  users      users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model medication_schedules {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medication_id String        @db.Uuid
  time_of_day   DateTime      @db.Time(6)
  days_of_week  Int           @default(127) @db.SmallInt
  start_date    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  end_date      DateTime?     @db.Date
  grace_minutes Int           @default(60) @db.SmallInt
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  dose_events   dose_events[]
  medications   medications   @relation(fields: [medication_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([medication_id], map: "idx_schedules_med")
}

model medications {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                 @db.Uuid
  name_enc             Bytes
  dosage_enc           Bytes?
  instructions_enc     Bytes?
  dispenser_slot       Int?                   @db.SmallInt
  pills_remaining      Int?
  alarm_sound          String                 @default("radial") @db.VarChar(32)
  is_active            Boolean                @default(true)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime?              @db.Timestamptz(6)
  medication_schedules medication_schedules[]
  users                users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model push_tokens {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String        @db.Uuid
  platform     push_platform
  token        String        @unique
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  last_used_at DateTime?     @db.Timestamptz(6)
  users        users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_push_tokens_user")
}

model refresh_tokens {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token_hash  String    @unique
  device_info String?   @db.VarChar(200)
  expires_at  DateTime  @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_refresh_tokens_user")
}

model robot_settings {
  user_id           String    @id @db.Uuid
  robot_name        String    @default("Pebble") @db.VarChar(50)
  voice_id          String    @default("default_th_female") @db.VarChar(50)
  speech_rate       Decimal   @default(1.00) @db.Decimal(3, 2)
  greeting_text     String    @default("สวัสดี {name} ยินดีที่ได้รู้จักนะ") @db.VarChar(200)
  wake_word         String    @default("Hey Pebble") @db.VarChar(30)
  face_theme        String    @default("default") @db.VarChar(30)
  quiet_hours_start DateTime? @db.Time(6)
  quiet_hours_end   DateTime? @db.Time(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                                                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                    String               @unique @db.Citext
  password_hash                                            String
  display_name                                             String               @db.VarChar(100)
  locale                                                   String               @default("th-TH") @db.VarChar(10)
  timezone                                                 String               @default("Asia/Bangkok") @db.VarChar(50)
  uses_medication                                          Boolean              @default(false)
  onboarded_at                                             DateTime?            @db.Timestamptz(6)
  pronunciation                                            String?              @db.VarChar(100)
  sex                                                      String?              @db.VarChar(10)
  birth_year                                               Int?                 @db.SmallInt
  phone                                                    String?              @db.VarChar(30)
  avatar_enc                                               Bytes?
  medical_enc                                              Bytes?
  robot_setup_at                                           DateTime?            @db.Timestamptz(6)
  app_setup_done_at                                        DateTime?            @db.Timestamptz(6)
  created_at                                               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at                                               DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at                                               DateTime?            @db.Timestamptz(6)
  alerts                                                   alerts[]
  audit_logs                                               audit_logs[]
  caretaker_links_caretaker_links_caretaker_user_idTousers caretaker_links[]    @relation("caretaker_links_caretaker_user_idTousers")
  caretaker_links_caretaker_links_user_idTousers           caretaker_links[]    @relation("caretaker_links_user_idTousers")
  chat_messages                                            chat_messages[]
  companion_memories                                       companion_memories[]
  consents                                                 consents[]
  conversations                                            conversations[]
  devices                                                  devices[]
  dose_events                                              dose_events[]
  emergency_contacts                                       emergency_contacts[]
  medications                                              medications[]
  push_tokens                                              push_tokens[]
  refresh_tokens                                           refresh_tokens[]
  robot_settings                                           robot_settings?
  mood_checkins                                            mood_checkins[]
  auth_identities                                          auth_identities[]
  password_resets                                          password_resets[]
}

enum alert_severity {
  info
  warning
  critical
}

enum alert_type {
  crisis
  missed_dose
  low_battery
  device_offline
  dispenser_jam
}

enum device_status {
  unpaired
  online
  offline
  charging
  error
}

enum dose_confirm_via {
  app
  robot_button
  robot_sensor
  caretaker
}

enum dose_status {
  pending
  taken
  skipped
  missed
}

enum link_status {
  pending
  accepted
  declined
  revoked
}

enum push_platform {
  ios
  android
  robot
}

model mood_checkins {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  score      Int      @db.SmallInt
  source     String   @default("app") @db.VarChar(20)
  note_enc   Bytes?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_mood_checkins_user_time")
}

model auth_identities {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  provider      String    @db.VarChar(20)
  subject       String    @db.VarChar(255)
  email         String?   @db.Citext
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  last_login_at DateTime? @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, subject])
  @@index([user_id], map: "idx_auth_identities_user")
}

model password_resets {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  code_hash        String    @db.VarChar(64)
  attempts         Int       @default(0) @db.SmallInt
  expires_at       DateTime  @db.Timestamptz(6)
  reset_token_hash String?   @unique @db.VarChar(64)
  reset_expires_at DateTime? @db.Timestamptz(6)
  used_at          DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_password_resets_user")
}

/// Chat history the user can read back (encrypted; owner only).
model chat_messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  user_id         String        @db.Uuid
  role            String
  content_enc     Bytes
  created_at      DateTime      @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "idx_chat_messages_convo")
  @@index([user_id, created_at(sort: Desc)], map: "idx_chat_messages_user")
}
